---
import Layout from "../layouts/Layout.astro";
import "../styles/index.css";
---

<Layout>
  <body>
    <div class="hero">
  <img
    class="hero-img"
    src="/img/heroBillede.png"
    alt="Stemningsbillede fra Impact Festival"
  />

  <div class="hero-section">
    <img
      class="trifo-logo"
      src="/img/trifoforside.png"
      alt="Trifolium logo"
    />

    <img
      class="impact-logo"
      src="/img/roedimpactlogo.png"
      alt="Impact Festival logo"
    />

    <p class="hero-text">
      12. - 13. September 2026
      Music // Art // Talks // Workshops // Food
      Designed to increase our impact
    </p>

    <a href="/tickets" class="button">Tickets</a>
  </div>
</div>

    <h1 class="section-title">IMPACT FESTIVAL</h1>

    <div class="info-box">
      <div class="info-card">
        <h2>WHY</h2>
        <p>We believe real impact happens when people come together to question, connect, and act.</p>
      </div>
      <div class="info-card">
        <h2>WHO</h2>
        <p>IMPACT FESTIVAL is both an event and a collaborative platform. It creates connections between ideas and action — bringing together those who want to shape future ways of living, creating, and working together.</p>
      </div>
      <div class="info-card">
        <h2>HOW</h2>
        <p>By creating a platform where art, ideas, and people meet to explore the challenges shaping our future.</p>
      </div>
      <div class="info-card">
        <h2>WHAT</h2>
        <p>IMPACT FESTIVAL is a two-day gathering of music, art, talks, workshops, food, and shared experiences at Trifolium in Copenhagen Sydhavnen.</p>
      </div>
    </div>

    <p class="read-more">Read more about Trifolium</p>
    <div class="read-more-btn">
      <a href="/about" class="button">TRIFOLIUM</a>
    </div>

    <div class="program-box" id="program">
      <h2>PROGRAM</h2>
	  <img src="/img/program.png" alt="Impact Festival Program" />
    </div>

    <h2 class="insta-title">FOLLOW US ON INSTAGRAM</h2>
    <div class="insta-grid">
      <div class="insta-box">
        <img src="/img/insta11.png" alt="Instagram Image 1" />
        <img src="/img/insta12.png" alt="Instagram Image 2" />
        <img src="/img/insta13.png" alt="Instagram Image 3" />
        <img src="/img/insta10.png" alt="Instagram Image 4" />
        <img src="/img/insta5.png" alt="Instagram Image 5" />
        <img src="/img/insta6.png" alt="Instagram Image 6" />
        <img src="/img/insta7.png" alt="Instagram Image 7" />
        <img src="/img/insta8.png" alt="Instagram Image 8" />
        <img src="/img/insta9.png" alt="Instagram Image 9" />
      </div>
    </div>
  </body>
</Layout>
