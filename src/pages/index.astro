---
import Layout from "../layouts/Layout.astro";
import "../styles/index.css";
---

<Layout>
  <body>
    <div class="hero">
      <img class="hero-img" src="" alt="" />
      <div class="hero-section">
        <img src="/img/trifoforside.png" alt="trifolium rødt logo" />
        <img src="/img/roedimpactlogo.png" alt="Impact Festival Logo" />
        <p class="hero-text">
          12. - 13. September 2026<br />Music // Art // Talks // Workshops // Food<br />Designed to increase our impact
        </p>
        <a href="/tickets" class="button">Tickets</a>
      </div>
    </div>

    <h2 class="section-title">IMPACT FESTIVAL</h2>

    <div class="info-box">
      <div class="info-card">
        <h3>WHY</h3>
        <p>We believe real impact happens when people come together to question, connect, and act.</p>
      </div>
      <div class="info-card">
        <h3>WHO</h3>
        <p>IMPACT FESTIVAL is both an event and a collaborative platform. It creates connections between ideas and action — bringing together those who want to shape future ways of living, creating, and working together.</p>
      </div>
      <div class="info-card">
        <h3>HOW</h3>
        <p>By creating a platform where art, ideas, and people meet to explore the challenges shaping our future.</p>
      </div>
      <div class="info-card">
        <h3>WHAT</h3>
        <p>IMPACT FESTIVAL is a two-day gathering of music, art, talks, workshops, food, and shared experiences at Trifolium in Copenhagen Sydhavnen.</p>
      </div>
    </div>

    <p class="read-more">Read more about Trifolium</p>
    <div class="read-more-btn">
      <a href="/about" class="button">TRIFOLIUM</a>
    </div>

    <div class="program-box" id="program">
      <h2>PROGRAM</h2>
    </div>

    <h2 class="insta-title">FOLLOW US ON INSTAGRAM</h2>
    <div class="insta-grid">
      <div class="insta-box">
        <img src="/img/insta1.png" alt="Instagram Image 1" />
        <img src="/img/insta2.png" alt="Instagram Image 2" />
        <img src="/img/insta3.png" alt="Instagram Image 3" />
        <img src="/img/insta4.png" alt="Instagram Image 4" />
        <img src="" alt="" />
        <img src="" alt="" />
        <img src="" alt="" />
        <img src="" alt="" />
        <img src="" alt="" />
      </div>
    </div>
  </body>
</Layout>
