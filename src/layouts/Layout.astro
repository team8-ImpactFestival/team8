---
import "../styles/layout.css";
---

<!doctype html>
<html lang="da">
  <head>
    <link href="https://fonts.googleapis.com/css2?family=Antonio:wght@100..700&display=swap" rel="stylesheet" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
	<meta name="robots" content="noindex, nofollow" />
    <title>Impact Festival</title>
  </head>

  <body>
    <header>
      <nav class="navbar">
        <a href="/" class="logo">
          <img src="/img/impactlogo.webp" alt="Impact Festival logo" />
        </a>

        <div class="nav-right">
          <a href="/about">ABOUT</a>
          <a href="/program">PROGRAM</a>
          <a href="/tickets">TICKETS</a>
          <a href="/newsletter">NEWSLETTER</a>

          <div class="socials">
            <a href="#" aria-label="Instagram">
              <img src="/img/insta.jpg" alt="" />
            </a>

            <a href="#" aria-label="LinkedIn">
              <img src="/img/linkedIn.avif" alt="" />
            </a>

            <a href="#" aria-label="Facebook">
              <img src="/img/fb.png" alt="" />
            </a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>
    <footer>
      <section class="grid2-1">
        <div class="impact">
          <a href="/" class="logo2">
            <img src="/img/impactlogo.webp" alt="Impact Festival logo" />
          </a>
        </div>
        <div>
          <div class="grid1">
            <h3>Location</h3><h3>Contact</h3>
            <p>Bådehavnsgade 42 <br /> 2450, København SV</p>
            <a href="mailto:impact@trifo.dk">impact@trifo.dk</a>
          </div>
          <p>IMPACT FESTIVAL is organized by Forening Impact, Sydhavnen, CVR no. 46334272, Bådehavnsgade 42, 2450 Copenhagen SV. Tickets are sold through billetsalg.dk</p>
        </div>
      </section>
    </footer>
  </body>
</html>
